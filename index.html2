<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>fablesbyp</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --blush: #f7e9ee;
    --lavender: #efe9f7;
    --cream: #fdf8f3;
    --plum: #4a2f4d;
    --rose: #c97b8e;
    --sage: #8fa583;
    --sage-dark: #6d8563;
    --gold: #dcb15a;
    --line: rgba(74,47,77,0.12);
    --radius: 22px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Quicksand', sans-serif;
    color:var(--plum);
    background:var(--cream) url('images/bg-gingham.jpg') repeat;
    background-size:220px;
    line-height:1.6;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:500;
    margin:0;
    letter-spacing:-0.01em;
  }
  p{margin:0;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;}

  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}

  /* ---------- NAV ---------- */
  header{
    position:sticky;top:0;z-index:40;
    background:rgba(253,248,243,0.9);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;}
  .logo{font-family:'Fraunces', serif;font-size:1.5rem;font-weight:600;color:var(--plum);}
  .logo span{color:var(--rose);}
  .nav-links{display:flex;gap:32px;align-items:center;}
  .nav-links a{font-size:0.98rem;font-weight:600;color:var(--plum);opacity:0.8;transition:opacity .2s;}
  .nav-links a:hover{opacity:1;}
  .cart-btn{
    display:flex;align-items:center;gap:8px;
    background:var(--plum);color:var(--cream);
    padding:10px 18px;border-radius:999px;font-weight:600;font-size:0.95rem;
    position:relative;
  }
  .cart-count{
    background:var(--rose);color:white;border-radius:999px;
    font-size:0.72rem;min-width:19px;height:19px;display:flex;align-items:center;justify-content:center;padding:0 5px;
  }
  .menu-toggle{display:none;background:none;border:none;font-size:1.6rem;color:var(--plum);}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    overflow:hidden;
    padding:90px 0 70px;
    background:transparent;
  }
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:center;}
  .eyebrow-tag{
    display:inline-flex;align-items:center;gap:8px;
    background:white;border:1px solid var(--line);
    padding:7px 16px;border-radius:999px;font-size:0.85rem;font-weight:600;color:var(--sage-dark);
    margin-bottom:22px;
  }
  .eyebrow-tag::before{content:"✦";color:var(--gold);}
  .hero h1{font-size:3.1rem;line-height:1.08;color:var(--plum);margin-bottom:20px;}
  .hero h1 em{font-style:italic;color:var(--rose);font-weight:500;}
  .hero p.lede{font-size:1.15rem;max-width:460px;opacity:0.82;margin-bottom:32px;}
  .btn-row{display:flex;gap:16px;flex-wrap:wrap;}
  .btn{
    padding:14px 28px;border-radius:999px;font-weight:700;font-size:0.98rem;
    display:inline-flex;align-items:center;gap:8px;transition:transform .18s ease, box-shadow .18s ease;
  }
  .btn-primary{background:var(--plum);color:var(--cream);}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(74,47,77,0.25);}
  .btn-outline{background:transparent;color:var(--plum);border:1.5px solid var(--plum);}
  .btn-outline:hover{background:var(--plum);color:var(--cream);}

  .hero-art{position:relative;height:420px;}
  .blob{
    position:absolute;border-radius:50% 50% 45% 55% / 55% 45% 55% 45%;
  }
  .blob-1{width:320px;height:320px;background:linear-gradient(135deg,var(--blush),var(--lavender));top:10px;right:20px;}
  .blob-2{width:150px;height:150px;background:var(--sage);opacity:0.35;bottom:0;left:10px;border-radius:60% 40% 50% 50% / 40% 60% 40% 60%;}
  .hero-badge{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:230px;height:230px;background:white;border-radius:50%;
    display:flex;align-items:center;justify-content:center;text-align:center;
    box-shadow:0 20px 50px rgba(74,47,77,0.18);
    padding:20px;
  }
  .hero-badge span{font-family:'Fraunces',serif;font-style:italic;font-size:1.3rem;color:var(--plum);}

  section{padding:80px 0;}
  .section-head{text-align:center;max-width:560px;margin:0 auto 48px;}
  .section-tag{color:var(--sage-dark);font-weight:700;font-size:0.9rem;margin-bottom:10px;display:block;}
  .section-head h2{font-size:2.3rem;color:var(--plum);}
  .section-head p{margin-top:14px;opacity:0.75;font-size:1.05rem;}

  /* ---------- SHOP ---------- */
  .shop{background:white;}
  .product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
  .card{
    background:var(--cream);border-radius:var(--radius);overflow:hidden;
    border:1px solid var(--line);transition:transform .2s ease, box-shadow .2s ease;
  }
  .card:hover{transform:translateY(-4px);box-shadow:0 16px 32px rgba(74,47,77,0.12);}
  .card-img{
    aspect-ratio:1/1;
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;font-style:italic;color:rgba(74,47,77,0.35);font-size:0.95rem;
    text-align:center;padding:20px;
  }
  .card-body{padding:20px;}
  .card-body h3{font-size:1.15rem;margin-bottom:6px;}
  .card-body .price{color:var(--rose);font-weight:700;margin-bottom:14px;display:block;}
  .add-btn{
    width:100%;padding:11px;border-radius:999px;background:var(--plum);color:var(--cream);
    font-weight:700;font-size:0.9rem;transition:background .2s;
  }
  .add-btn:hover{background:var(--rose);}
  .add-btn.added{background:var(--sage-dark);}

  /* ---------- CUSTOM ---------- */
  .custom{
    background:linear-gradient(135deg, var(--lavender), var(--blush));
  }
  .custom-box{
    background:white;border-radius:32px;padding:54px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;
  }
  .custom-box h2{font-size:2rem;margin-bottom:16px;}
  .custom-box p{opacity:0.78;margin-bottom:26px;}
  .custom-perks{list-style:none;padding:0;margin:0 0 28px;display:flex;flex-direction:column;gap:10px;}
  .custom-perks li{display:flex;gap:10px;font-size:0.95rem;}
  .custom-perks li::before{content:"❀";color:var(--rose);}
  .custom-art{
    height:280px;border-radius:24px;
    background:radial-gradient(circle at 30% 30%, var(--blush), var(--lavender) 70%);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;font-style:italic;color:var(--plum);opacity:0.5;text-align:center;padding:20px;
  }

  /* ---------- REVIEWS ---------- */
  .reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .review-shot{
    background:var(--cream);border:1px solid var(--line);border-radius:18px;
    aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;
    font-size:0.85rem;color:rgba(74,47,77,0.4);text-align:center;padding:16px;
  }

  footer{background:var(--plum);color:var(--cream);padding:60px 0 30px;}
  .footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:40px;margin-bottom:40px;}
  footer .logo{color:var(--cream);}
  footer .logo span{color:#e3a6b6;}
  footer p{opacity:0.7;margin-top:12px;font-size:0.92rem;max-width:280px;}
  footer h4{font-size:0.95rem;margin-bottom:16px;opacity:0.9;}
  footer ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;}
  footer a{opacity:0.75;font-size:0.92rem;}
  footer a:hover{opacity:1;}
  .footer-bottom{border-top:1px solid rgba(253,248,243,0.15);padding-top:24px;font-size:0.85rem;opacity:0.55;text-align:center;}

  /* ---------- CART DRAWER ---------- */
  .overlay{
    position:fixed;inset:0;background:rgba(74,47,77,0.35);
    opacity:0;pointer-events:none;transition:opacity .25s ease;z-index:60;
  }
  .overlay.show{opacity:1;pointer-events:auto;}
  .drawer{
    position:fixed;top:0;right:0;height:100%;width:400px;max-width:92vw;
    background:var(--cream);z-index:70;box-shadow:-10px 0 40px rgba(0,0,0,0.15);
    transform:translateX(100%);transition:transform .3s ease;
    display:flex;flex-direction:column;
  }
  .drawer.show{transform:translateX(0);}
  .drawer-head{padding:24px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;}
  .drawer-head h3{font-size:1.3rem;}
  .close-btn{font-size:1.4rem;color:var(--plum);}
  .cart-items{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:16px;}
  .cart-empty{text-align:center;opacity:0.55;padding:60px 20px;font-size:0.95rem;}
  .cart-item{display:flex;gap:14px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:16px;}
  .cart-item-thumb{
    width:60px;height:60px;border-radius:12px;background:var(--blush);flex-shrink:0;
    display:flex;align-items:center;justify-content:center;font-size:0.65rem;color:rgba(74,47,77,0.4);text-align:center;
  }
  .cart-item-info{flex:1;}
  .cart-item-info h4{font-size:0.95rem;margin-bottom:4px;}
  .qty-row{display:flex;align-items:center;gap:10px;margin-top:6px;}
  .qty-btn{width:24px;height:24px;border-radius:50%;background:var(--lavender);font-weight:700;display:flex;align-items:center;justify-content:center;}
  .remove-link{font-size:0.8rem;color:var(--rose);font-weight:600;margin-left:auto;}
  .drawer-foot{padding:22px 24px;border-top:1px solid var(--line);}
  .total-row{display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem;margin-bottom:16px;}
  .checkout-btn{width:100%;padding:15px;background:var(--plum);color:var(--cream);border-radius:999px;font-weight:700;}
  .checkout-btn:disabled{opacity:0.4;cursor:not-allowed;}

  /* ---------- CHECKOUT MODAL ---------- */
  .modal{
    position:fixed;inset:0;z-index:80;display:none;align-items:center;justify-content:center;padding:24px;
  }
  .modal.show{display:flex;}
  .modal-card{
    background:white;border-radius:28px;max-width:560px;width:100%;max-height:88vh;overflow-y:auto;
    padding:40px;position:relative;
  }
  .modal-close{position:absolute;top:20px;right:24px;font-size:1.5rem;color:var(--plum);}
  .modal-card h2{font-size:1.6rem;margin-bottom:6px;}
  .modal-card > p.sub{opacity:0.65;margin-bottom:26px;font-size:0.95rem;}
  .order-summary{background:var(--cream);border-radius:16px;padding:16px 18px;margin-bottom:26px;}
  .order-summary .line{display:flex;justify-content:space-between;font-size:0.9rem;padding:5px 0;}
  .order-summary .total{font-weight:700;border-top:1px solid var(--line);margin-top:8px;padding-top:10px;}
  .field{margin-bottom:16px;}
  .field label{display:block;font-size:0.88rem;font-weight:700;margin-bottom:6px;}
  .field input,.field textarea{
    width:100%;padding:12px 14px;border-radius:12px;border:1.5px solid var(--line);
    font-family:inherit;font-size:0.95rem;background:var(--cream);
  }
  .field input:focus,.field textarea:focus{outline:2px solid var(--rose);outline-offset:1px;}
  .bank-box{
    background:var(--lavender);border-radius:16px;padding:20px;margin:22px 0;
  }
  .bank-box h4{font-size:0.95rem;margin-bottom:12px;}
  .bank-line{display:flex;justify-content:space-between;font-size:0.9rem;padding:5px 0;}
  .bank-line span:first-child{opacity:0.65;}
  .bank-note{font-size:0.82rem;opacity:0.7;margin-top:12px;line-height:1.5;}
  .upload-box{
    border:1.5px dashed var(--line);border-radius:14px;padding:20px;text-align:center;
    font-size:0.88rem;opacity:0.75;margin-bottom:22px;cursor:pointer;
  }
  .upload-box.has-file{border-color:var(--sage-dark);opacity:1;color:var(--sage-dark);font-weight:600;}
  .submit-btn{width:100%;padding:15px;background:var(--plum);color:var(--cream);border-radius:999px;font-weight:700;font-size:1rem;}
  .success-box{text-align:center;padding:20px 0;}
  .success-box .check{font-size:2.6rem;margin-bottom:14px;}

  @media (max-width:860px){
    .nav-links{display:none;}
    .menu-toggle{display:block;}
    .hero-grid{grid-template-columns:1fr;}
    .hero-art{height:280px;order:-1;}
    .hero h1{font-size:2.3rem;}
    .product-grid{grid-template-columns:repeat(2,1fr);}
    .custom-box{grid-template-columns:1fr;padding:32px;}
    .reviews-grid{grid-template-columns:repeat(2,1fr);}
    .footer-grid{grid-template-columns:1fr;gap:28px;}
  }
</style>
</head>
<body>

<header>
  <nav class="wrap">
    <a href="#" class="logo">fables<span>by</span>p</a>
    <div class="nav-links">
      <a href="#shop">shop</a>
      <a href="#custom">custom orders</a>
      <a href="#reviews">reviews</a>
    </div>
    <button class="cart-btn" onclick="openCart()">
      cart <span class="cart-count" id="cartCount">0</span>
    </button>
  </nav>
</header>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow-tag">handmade, made to order</span>
      <h1>little stories,<br><em>made by hand</em> for you</h1>
      <p class="lede">Every piece from fablesbyp is made to order, one at a time — pick a design from the shop or send in something completely your own.</p>
      <div class="btn-row">
        <a href="#shop" class="btn btn-primary">Browse the shop</a>
        <a href="#custom" class="btn btn-outline">Request a custom</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="hero-badge"><span>handmade with care, one story at a time</span></div>
    </div>
  </div>
</section>

<section class="shop" id="shop">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">the shop</span>
      <h2>Pick your favourite</h2>
      <p>Swap these placeholders for your own product photos, names and prices — add as many as you like.</p>
    </div>
    <div class="product-grid" id="productGrid"></div>
  </div>
</section>

<section class="custom" id="custom">
  <div class="wrap">
    <div class="custom-box">
      <div>
        <h2>Have something in mind?</h2>
        <p>Send over your idea — a photo, a colour palette, a whole mood board — and we'll bring it to life just for you.</p>
        <ul class="custom-perks">
          <li>We'll confirm every detail with you before starting</li>
          <li>No payment needed until your order is confirmed</li>
          <li>Made just for you, start to finish</li>
        </ul>
        <div class="btn-row">
          <a href="#" id="waCustomBtn" class="btn btn-primary" target="_blank">Message on WhatsApp</a>
          <a href="#" id="igCustomBtn" class="btn btn-outline" target="_blank">DM on Instagram</a>
        </div>
      </div>
      <div class="custom-art">your custom-order artwork or photo goes here</div>
    </div>
  </div>
</section>

<section id="reviews">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">kind words</span>
      <h2>What people are saying</h2>
      <p>Screenshots from happy customers — swap these placeholders in for the real thing whenever you have them.</p>
    </div>
    <div class="reviews-grid" id="reviewsGrid"></div>
  </div>
</section>

<footer>
  <div class="wrap footer-grid">
    <div>
      <a href="#" class="logo">fables<span>by</span>p</a>
      <p>Handmade pieces, made to order, with a story behind every one.</p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="#shop">Shop</a></li>
        <li><a href="#custom">Custom orders</a></li>
        <li><a href="#reviews">Reviews</a></li>
      </ul>
    </div>
    <div>
      <h4>Find us</h4>
      <ul>
        <li><a href="#" id="igFooterLink">Instagram</a></li>
        <li><a href="#" id="waFooterLink">WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">© 2026 fablesbyp. All pieces handmade to order.</div>
</footer>

<!-- CART DRAWER -->
<div class="overlay" id="overlay" onclick="closeAll()"></div>
<aside class="drawer" id="drawer">
  <div class="drawer-head">
    <h3>Your cart</h3>
    <button class="close-btn" onclick="closeAll()">&times;</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="drawer-foot">
    <div class="total-row"><span>Total</span><span id="cartTotal">Rs 0</span></div>
    <button class="checkout-btn" id="checkoutBtn" onclick="openCheckout()" disabled>Proceed to checkout</button>
  </div>
</aside>

<!-- CHECKOUT MODAL -->
<div class="modal" id="checkoutModal">
  <div class="modal-card">
    <button class="modal-close" onclick="closeAll()">&times;</button>

    <div id="checkoutForm">
      <h2>Checkout</h2>
      <p class="sub">Transfer the total below, then attach your payment screenshot as proof.</p>

      <div class="order-summary" id="orderSummary"></div>

      <div class="field">
        <label for="custName">Full name</label>
        <input type="text" id="custName" placeholder="Your name">
      </div>
      <div class="field">
        <label for="custPhone">Phone number</label>
        <input type="text" id="custPhone" placeholder="03XX XXXXXXX">
      </div>
      <div class="field">
        <label for="custAddress">Delivery address</label>
        <textarea id="custAddress" rows="2" placeholder="House / street / city"></textarea>
      </div>

      <div class="bank-box">
        <h4>Bank transfer details</h4>
        <div class="bank-line"><span>Bank name</span><span>[Your Bank Name]</span></div>
        <div class="bank-line"><span>Account title</span><span>[Account Holder Name]</span></div>
        <div class="bank-line"><span>Account number</span><span>[XXXX-XXXXXXX-X]</span></div>
        <div class="bank-line"><span>IBAN</span><span>[PKXX XXXX ...]</span></div>
        <p class="bank-note">Replace the placeholders above with your real bank / Easypaisa / JazzCash details. Transfer the exact total shown above, then upload a screenshot of the payment as proof below.</p>
      </div>

      <label class="upload-box" id="uploadBox" for="proofUpload">
        <span id="uploadLabel">📎 Click to attach your payment screenshot</span>
        <input type="file" id="proofUpload" accept="image/*" style="display:none;">
      </label>

      <button class="submit-btn" onclick="submitOrder()">Submit order</button>
    </div>

    <div id="checkoutSuccess" class="success-box" style="display:none;">
      <div class="check">🌿</div>
      <h2>Order sent!</h2>
      <p class="sub">Thanks — we'll confirm your order shortly. Keep an eye on your email or WhatsApp.</p>
      <button class="btn btn-primary" style="margin-top:10px;" onclick="closeAll()">Done</button>
    </div>
  </div>
</div>

<script>
  /* ---------- CONFIG: EDIT THESE ---------- */
  const WHATSAPP_NUMBER = "923000000000"; // replace with real number, country code no +
  const INSTAGRAM_HANDLE = "fablesbyp";   // replace with real handle

  // For each product: leave "img" empty ("") to show a placeholder box,
  // or set it to a path like "images/set-one.jpg" to show your real photo.
  const products = [
    {id:1, name:"Placeholder Set One", price:1200, img:""},
    {id:2, name:"Placeholder Set Two", price:1500, img:""},
    {id:3, name:"Placeholder Set Three", price:1350, img:""},
    {id:4, name:"Placeholder Set Four", price:1600, img:""},
    {id:5, name:"Placeholder Set Five", price:1100, img:""},
    {id:6, name:"Placeholder Set Six", price:1750, img:""},
  ];

  // For each review: leave "img" empty ("") for a placeholder box,
  // or set it to a path like "images/review1.jpg" to show a real screenshot.
  const reviews = [
    {id:1, img:"images/review1.jpg"},
    {id:2, img:""},
    {id:3, img:""},
    {id:4, img:""},
    {id:5, img:""},
    {id:6, img:""},
  ];

  /* ---------- STATE (in-memory only, no browser storage) ---------- */
  let cart = [];
  let proofFile = null;

  /* ---------- RENDER PRODUCTS ---------- */
  const grid = document.getElementById('productGrid');
  products.forEach(p => {
    const card = document.createElement('div');
    card.className = 'card';
    const imgHtml = p.img
      ? `<img src="${p.img}" alt="${p.name}" style="width:100%;height:100%;object-fit:cover;">`
      : `your product photo`;
    card.innerHTML = `
      <div class="card-img">${imgHtml}</div>
      <div class="card-body">
        <h3>${p.name}</h3>
        <span class="price">Rs ${p.price.toLocaleString()}</span>
        <button class="add-btn" data-id="${p.id}">Add to cart</button>
      </div>`;
    grid.appendChild(card);
  });
  grid.addEventListener('click', e => {
    if(e.target.classList.contains('add-btn')){
      const id = Number(e.target.dataset.id);
      addToCart(id);
      e.target.textContent = "Added ✓";
      e.target.classList.add('added');
      setTimeout(()=>{ e.target.textContent = "Add to cart"; e.target.classList.remove('added'); }, 1200);
    }
  });

  /* ---------- RENDER REVIEWS ---------- */
  const rGrid = document.getElementById('reviewsGrid');
  reviews.forEach(r => {
    const d = document.createElement('div');
    d.className = 'review-shot';
    if(r.img){
      d.innerHTML = `<img src="${r.img}" alt="Customer review" style="width:100%;height:100%;object-fit:cover;border-radius:18px;">`;
    } else {
      d.textContent = `review screenshot ${r.id}`;
    }
    rGrid.appendChild(d);
  });

  /* ---------- CART LOGIC ---------- */
  function addToCart(id){
    const existing = cart.find(i => i.id === id);
    if(existing){ existing.qty++; }
    else {
      const p = products.find(p => p.id === id);
      cart.push({...p, qty:1});
    }
    renderCart();
  }
  function changeQty(id, delta){
    const item = cart.find(i => i.id === id);
    if(!item) return;
    item.qty += delta;
    if(item.qty <= 0){ cart = cart.filter(i => i.id !== id); }
    renderCart();
  }
  function removeItem(id){
    cart = cart.filter(i => i.id !== id);
    renderCart();
  }
  function cartTotal(){
    return cart.reduce((sum,i)=> sum + i.price*i.qty, 0);
  }
  function renderCart(){
    const itemsEl = document.getElementById('cartItems');
    const countEl = document.getElementById('cartCount');
    const totalEl = document.getElementById('cartTotal');
    const checkoutBtn = document.getElementById('checkoutBtn');

    countEl.textContent = cart.reduce((s,i)=>s+i.qty,0);
    totalEl.textContent = 'Rs ' + cartTotal().toLocaleString();
    checkoutBtn.disabled = cart.length === 0;

    if(cart.length === 0){
      itemsEl.innerHTML = '<div class="cart-empty">Your cart is empty — go add something you love.</div>';
      return;
    }
    itemsEl.innerHTML = cart.map(i => `
      <div class="cart-item">
        <div class="cart-item-thumb">${i.img ? `<img src="${i.img}" alt="${i.name}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">` : ''}</div>
        <div class="cart-item-info">
          <h4>${i.name}</h4>
          <div>Rs ${i.price.toLocaleString()}</div>
          <div class="qty-row">
            <button class="qty-btn" onclick="changeQty(${i.id},-1)">−</button>
            <span>${i.qty}</span>
            <button class="qty-btn" onclick="changeQty(${i.id},1)">+</button>
            <span class="remove-link" onclick="removeItem(${i.id})">Remove</span>
          </div>
        </div>
      </div>`).join('');
  }

  /* ---------- DRAWER / MODAL CONTROLS ---------- */
  function openCart(){
    document.getElementById('drawer').classList.add('show');
    document.getElementById('overlay').classList.add('show');
  }
  function closeAll(){
    document.getElementById('drawer').classList.remove('show');
    document.getElementById('overlay').classList.remove('show');
    document.getElementById('checkoutModal').classList.remove('show');
  }
  function openCheckout(){
    if(cart.length === 0) return;
    document.getElementById('checkoutForm').style.display = 'block';
    document.getElementById('checkoutSuccess').style.display = 'none';
    const summary = document.getElementById('orderSummary');
    summary.innerHTML = cart.map(i => `
      <div class="line"><span>${i.name} × ${i.qty}</span><span>Rs ${(i.price*i.qty).toLocaleString()}</span></div>
    `).join('') + `<div class="line total"><span>Total</span><span>Rs ${cartTotal().toLocaleString()}</span></div>`;
    document.getElementById('checkoutModal').classList.add('show');
  }

  /* ---------- FILE UPLOAD ---------- */
  document.getElementById('proofUpload').addEventListener('change', e => {
    const file = e.target.files[0];
    const box = document.getElementById('uploadBox');
    const label = document.getElementById('uploadLabel');
    if(file){
      proofFile = file;
      box.classList.add('has-file');
      label.textContent = `✓ Attached: ${file.name}`;
    }
  });

  /* ---------- SUBMIT ---------- */
  function submitOrder(){
    const name = document.getElementById('custName').value.trim();
    const phone = document.getElementById('custPhone').value.trim();
    const address = document.getElementById('custAddress').value.trim();

    if(!name || !phone || !address){
      alert('Please fill in your name, phone and address.');
      return;
    }
    if(!proofFile){
      alert('Please attach your payment screenshot before submitting.');
      return;
    }

    // NOTE: This currently just shows a success message. To make orders actually
    // reach an inbox, connect this form to a free form-to-email service
    // (e.g. Web3Forms, FormSubmit) and send `name`, `phone`, `address`,
    // the order summary, and `proofFile` to it here.

    document.getElementById('checkoutForm').style.display = 'none';
    document.getElementById('checkoutSuccess').style.display = 'block';
    cart = [];
    proofFile = null;
    renderCart();
  }

  /* ---------- WHATSAPP / INSTAGRAM LINKS ---------- */
  function buildWaLink(){
    const msg = encodeURIComponent("Hi! I'd like to ask about a custom order from fablesbyp ✨");
    return `https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`;
  }
  function buildIgLink(){
    return `https://instagram.com/${INSTAGRAM_HANDLE}`;
  }
  document.getElementById('waCustomBtn').href = buildWaLink();
  document.getElementById('igCustomBtn').href = buildIgLink();
  document.getElementById('waFooterLink').href = buildWaLink();
  document.getElementById('igFooterLink').href = buildIgLink();

  renderCart();
</script>
</body>
</html>
